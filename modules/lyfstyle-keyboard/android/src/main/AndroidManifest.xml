<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Voice typing: only used while the person taps the mic on the Lyfstyle keyboard. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Android 11+: lets the keyboard find the phone's speech recogniser. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application>
        <service
            android:name="com.tabsphere.keyboardlyfstyle.keyboard.LyfstyleImeService"
            android:label="Lyfstyle Keyboard"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:exported="true">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/lyfstyle_input_method" />
        </service>
    </application>
</manifest>
