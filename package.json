{
  "name": "keyboard-lyfstyle",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "generate": "node scripts/build-styles.mjs",
    "postinstall": "patch-package",
    "test": "npm run generate && tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "export:web": "expo export --platform web",
    "prebuild": "expo prebuild --clean",
    "lint": "expo lint"
  },
  "dependencies": {
    "@bacons/apple-targets": "5.0.0",
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@expo-google-fonts/geist": "^0.4.2",
    "@expo-google-fonts/geist-mono": "^0.4.3",
    "@expo/metro-runtime": "~55.0.12",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~55.0.32",
    "expo-build-properties": "~55.0.18",
    "expo-clipboard": "~55.0.17",
    "expo-constants": "~55.0.17",
    "expo-font": "~55.0.8",
    "expo-haptics": "~55.0.18",
    "expo-iap": "^6.5.1",
    "expo-linking": "~55.0.17",
    "expo-router": "~55.0.18",
    "expo-splash-screen": "~55.0.25",
    "expo-status-bar": "~55.0.6",
    "lucide-react-native": "^1.77.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~55.0.1",
    "patch-package": "^8.0.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.2"
